      <dialog name='quick_start' show_again='true'/>

    </gui>

    <include>
      <uri>file:///root/limo_ws/install/limo_description/share/limo_description/worlds/world_povo_resources</uri>
      <name>Povo</name>
      <!--      <pose>109.9974940 27.50200376 -0.20000000000000001 0 0 -1.5707963267948966</pose>-->
      <pose>0 0 0.20000000000000001 0 0 1.5707963267948966</pose>
    </include>
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.10000000000000001 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
  </world>
</sdf>