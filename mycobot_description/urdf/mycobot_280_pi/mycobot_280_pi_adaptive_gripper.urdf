       <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/joint4.dae"/>
      </geometry>
    <origin xyz = "0.0 0 0.03056 " rpy = " 0 -1.5708 0"/>
    </collision>-->
  </link>



  <link name="joint5">
    <xacro:link_inertial mass="${joint5_mass}" ixx="0.000103" iyy="0.000103" izz="0.000096"/>
    <visual>
      <geometry>
       <!--- 0.0 0 -0.04 -->
        <box size="0.03 0.035 0.05"/>
      <!--<mesh filename="package://mycobot_description/urdf/mycobot_280_pi/joint5.dae"/>-->
      </geometry>
      <origin xyz="0.0 0 -0.005" rpy="0 0.0 0"/>
    <!--<origin xyz = "0.0 -0.001 -0.0345 " rpy = " 0 -1.5708 1.5708"/>-->
    </visual>
    <collision>
        <geometry>
            <box size="0.03 0.035 0.05"/>
        </geometry>
        <origin xyz="0.0 0 -0.005" rpy="0 0.0 0"/>
