    <origin xyz = "0.0 0 -0.012 " rpy = " 0 0 0"/>
    </collision>-->
  </link>


  <joint name="g_base_to_joint1" type="fixed">
    <parent link="g_base"/>
    <child link="joint1"/>
    <origin xyz= "0 0 0" rpy = "0 0 0"/>  
  </joint>


  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${joint_effort}" lower="-2.879793" upper="2.879793" velocity="${joint_velocity}"/>
    <parent link="joint1"/>
    <child link="joint2"/>
    <origin xyz= "0 0 0.13956" rpy = "0 0 0"/> 
  </joint>


  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${joint_effort}" lower="-2.879793" upper="2.879793" velocity="${joint_velocity}"/>
    <parent link="joint2"/>
    <child link="joint3"/>
    <origin xyz= "0 0 -0.001" rpy = "0 1.5708 -1.5708"/>  
  </joint>


  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort="${joint_effort}" lower="-2.879793" upper="2.879793" velocity="${joint_velocity}"/>
    <parent link="joint3"/>
    <child link="joint4"/>
    <origin xyz= "  -0.1104 0 0   " rpy = "0 0 0"/>  
  </joint>



  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort="${joint_effort}" lower="-2.879793" upper="2.879793" velocity="${joint_velocity}"/>
    <parent link="joint4"/>
    <child link="joint5"/>
    <origin xyz= "-0.096 0 0.06462" rpy = "0 0 -1.5708"/>  
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${joint_effort}" lower="-2.879793" upper="2.879793" velocity="${joint_velocity}"/>
    <parent link="joint5"/>
    <child link="joint6"/>
    <origin xyz= "0 -0.07318 -0.001" rpy = "1.5708 -1.5708 0"/>  
  </joint>

  <joint name="joint6output_to_joint6" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${joint_effort}" lower="-3.054326" upper="3.054326" velocity="${joint_velocity}"/>
    <parent link="joint6"/>
    <child link="joint6_flange"/>
    <origin xyz= "0 0.0456 0" rpy = "-1.5708 0 0"/>  
  </joint>

  <joint name="joint6output_to_gripper_base" type="fixed">
    <axis xyz="0 0 1"/>
    <limit effort = "${joint_effort}" lower = "-3.14" upper = "3.14159" velocity = "${joint_velocity}"/>
    <parent link="joint6_flange"/>
    <child link="gripper_base"/>
    <!-- <origin xyz= "0 0.0 0" rpy = "-1.5708 0 0"/>   -->
    <origin xyz= "0 0 0.034" rpy = "1.579 0 0"/>  
  </joint>

  <link name="gripper_base">
    <xacro:link_inertial mass="${gripper_base_mass}" ixx="0.000010725" iyy="0.000014392" izz="0.000018517"/>
    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_base.dae"/>
      </geometry>
    <origin xyz = "0.0 0 -0.012 " rpy = " 0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.065 0.025 0.025"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </collision>
    <!--<collision>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_base.dae"/>
      </geometry>
    <origin xyz = "0.0 0 -0.012 " rpy = " 0 0 0"/>
    </collision>-->
  </link>

  <link name="gripper_left1">
    <xacro:link_inertial mass="${gripper_link_mass}" ixx="1e-6" iyy="1e-6" izz="1e-6"/>
    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left1.dae"/>
      </geometry>
    <origin xyz = "0.039 -0.0133 -0.012 " rpy = " 0 0 0"/>
    </visual>
    <collision>
        <geometry>
