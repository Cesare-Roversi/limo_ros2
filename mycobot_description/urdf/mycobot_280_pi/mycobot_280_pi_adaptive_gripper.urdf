<?xml version="1.1"?>
<robot  xmlns:xacro="http://www.ros.org/wiki/xacro" name="firefighter" >
	
<xacro:property name="width" value=".2" />


<xacro:property name="joint_effort" value="56.0"/>
<xacro:property name="joint_velocity" value="2.792527"/>
<xacro:property name="gripper_joint_effort" value="12.0"/>
<xacro:property name="gripper_joint_velocity" value="0.9"/>

<xacro:property name="g_base_mass" value="0.33"/>
<xacro:property name="joint1_mass" value="0.12"/>
<xacro:property name="joint2_mass" value="0.19"/>
<xacro:property name="joint3_mass" value="0.16"/>
<xacro:property name="joint4_mass" value="0.124"/>
<xacro:property name="joint5_mass" value="0.11"/>
<xacro:property name="joint6_mass" value="0.0739"/>
<xacro:property name="joint6_flange_mass" value="0.035"/>
<xacro:property name="gripper_base_mass" value="0.07"/>
<xacro:property name="gripper_link_mass" value="0.007"/>

<xacro:macro name="link_inertial" params="mass ixx iyy izz">
<inertial>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
    <mass value="${mass}"/>
    <inertia
    ixx="${ixx}" ixy="0.0" ixz="0.0"
                iyy="${iyy}" iyz="0.0"
                            izz="${izz}"/>
</inertial>
</xacro:macro>

<xacro:macro name="firefighter">	


  <link name="g_base">
    <xacro:link_inertial mass="${g_base_mass}" ixx="0.000784" iyy="0.000867" izz="0.001598"/>
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/G_base.dae"/>
      </geometry>
      <origin xyz = "0.0 0 -0.03" rpy = "0 0 1.5708"/>
    </visual>
    <collision>
        <geometry>
            <box size="0.105 0.14 0.02"/>
        </geometry>
        <origin xyz="0.0 0.0 -0.015" rpy="0 0 0"/>
    </collision>
    <!--<collision>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/G_base.dae"/>
      </geometry>
      <origin xyz = "0.0 0 -0.03" rpy = "0 0 1.5708"/>
    </collision>-->
  </link>

